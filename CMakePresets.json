{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "Windows (MinGW)",
      "description": "Release build with MinGW gcc. gcc and mingw32-make must be on PATH.",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_MAKE_PROGRAM": "mingw32-make"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows",
      "configurePreset": "windows"
    }
  ],
  "testPresets": [
    {
      "name": "windows",
      "configurePreset": "windows"
    }
  ]
}
